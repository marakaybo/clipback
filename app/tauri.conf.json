{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipback",
  "version": "0.4.7",
  "identifier": "io.github.clipback",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Запись последних минут экрана",
    "longDescription": "Clipback держит в памяти последние минуты экрана и сохраняет их по горячей клавише, с обрезкой прямо в программе.",
    "category": "Video",
    "copyright": "GPL-3.0-or-later",
    "createUpdaterArtifacts": true,
    "publisher": "Clipback",
    "homepage": "https://github.com/marakaybo/clipback",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4Q0JCNEQ3MzQ5ODhCQkIKUldTN2k1ZzAxN1RMMkhkSHVaWHRaVFkyUWl0c0YrVWlMNkUxWS91eEVmU3lsTm1qQ1gvTnIyQkkK",
      "endpoints": [
        "https://github.com/marakaybo/clipback/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
